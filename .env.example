YOUTUBE_API_KEY=your-youtube-data-api-v3-key
YOUTUBE_CHANNEL_ID=your-channel-id

# Contact form: create an access key at https://web3forms.com (free tier),
# tie it to your real inbox there, and put it here. This value is safe
# to expose in the built site - Web3Forms only reveals the access key,
# never the destination email, and the key can only submit to that inbox.
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
