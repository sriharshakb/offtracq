YOUTUBE_API_KEY=your-youtube-data-api-v3-key
YOUTUBE_CHANNEL_ID=your-channel-id

# Contact form: create a form at https://formspree.io (free tier),
# tie it to your real inbox there, and put its endpoint here. This
# value is safe to expose in the built site - Formspree only reveals
# the anonymous form ID, never the destination email.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
